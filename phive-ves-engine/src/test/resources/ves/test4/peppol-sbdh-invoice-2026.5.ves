<ves xmlns="urn:com:helger:phive:ves:v1.0">
  <groupId>org.peppol.bis3.sbdh-envelope</groupId>
  <artifactId>invoice</artifactId>
  <version>2026.5</version>

  <name>OpenPeppol UBL Invoice in SBDH (2026.5)</name>

  <!-- 1. The SBDH -->
  <requires>
    <groupId>un.unece.uncefact</groupId>
    <artifactId>sbdh</artifactId>
    <version>1.3</version>
  </requires>

  <!-- 2. The complete Peppol BIS Billing VES, applied on the contained Invoice only -->
  <partialRequires>
    <groupId>eu.peppol.bis3</groupId>
    <artifactId>invoice</artifactId>
    <version>2026.5</version>
    <namespaces>
      <namespace prefix="sh" uri="http://www.unece.org/cefact/namespaces/StandardBusinessDocumentHeader" />
      <namespace prefix="ubl" uri="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2" />
    </namespaces>
    <partial>
      <xpath>/sh:StandardBusinessDocument/ubl:Invoice</xpath>
      <minNodeCount>1</minNodeCount>
      <maxNodeCount>1</maxNodeCount>
    </partial>
  </partialRequires>

  <!-- 3. The Peppol BIS Envelope Rules - only for BIS Billing and Self-Billing -->
  <schematron>
    <resource>
      <groupId>org.peppol.bis3.sbdh-envelope</groupId>
      <artifactId>envelope-rules</artifactId>
      <version>2026.5</version>
      <type>xslt</type>
    </resource>
    <precondition type="xpath">normalize-space(/sh:StandardBusinessDocument/*/cbc:CustomizationID) = 'urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:billing:3.0' or normalize-space(/sh:StandardBusinessDocument/*/cbc:CustomizationID) = 'urn:cen.eu:en16931:2017#compliant#urn:fdc:peppol.eu:2017:poacc:selfbilling:3.0'</precondition>
    <namespaces>
      <namespace prefix="sh" uri="http://www.unece.org/cefact/namespaces/StandardBusinessDocumentHeader" />
      <namespace prefix="cbc" uri="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2" />
    </namespaces>
  </schematron>
</ves>
